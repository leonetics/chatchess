{
  "schemaVersion": 1,
  "id": "chat-chess",
  "version": "${version}",
  "name": "Chat Chess",
  "description": "An addon that allows you to play chess with other players.",
  "authors": [
    "Leonetic"
  ],
  "contact": {
    "sources": "https://github.com/Leonetic/chat-chess"
  },
  "icon": "assets/chatchess/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.leonetic.chatchess.ChatChess"
    ]
  },
  "mixins": [
    "chatchess.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
